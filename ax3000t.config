#
# Xiaomi Mi Router AX3000T (MT7981, UBoot Mod) - ImmortalWrt 24.10.6 精简构建配置
# 设备：Xiaomi Mi Router AX3000T（OpenWrt U-Boot layout；无 USB 接口）
#
# 用法：
#   cp ax3000t.config .config
#   make defconfig
#   make download -j8
#   make -j$(nproc) V=s
#
# 说明：
#   1. 本文件只保留“目标设备 / 镜像 / 应用”三类手动选择；
#      内核、BusyBox、依赖包、工具链等选项由 make defconfig 自动补齐。
#   2. 增删应用时只改“应用及其依赖”一节，不要把 menuconfig 全量输出直接提交。
#   3. 单设备构建；本机型无 USB 接口，不包含磁盘管理 / 硬盘休眠 / Samba。
#

# ============================================================
# 一、目标平台与设备
# ============================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 单设备构建（显式关闭多设备模式）
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod=y

# ============================================================
# 二、固件镜像
# ============================================================
# squashfs 只读根文件系统（配置保存在 overlay）
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 根分区大小（MiB），160 为上游默认值，可按需调大
CONFIG_TARGET_ROOTFS_PARTSIZE=160
# recovery initramfs（xz 压缩、独立 ramdisk）由设备默认配置生成，无需手写

# ============================================================
# 三、LuCI 基础与语言
# ============================================================
# 标准 LuCI（含 firewall、package-manager、网络/状态/系统模块）
CONFIG_PACKAGE_luci=y
# 简体中文；各应用的 luci-i18n-*-zh-cn 会随语言选项自动选中
CONFIG_LUCI_LANG_zh_Hans=y

# ============================================================
# 四、应用及其依赖
# ============================================================
# 本模块集中所有手动选择的应用；依赖包由 make defconfig 自动选中
# 主题：Argon
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# 在线升级（Attended Sysupgrade）
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
# 定时自动重启
CONFIG_PACKAGE_luci-app-autoreboot=y
# Web 终端
CONFIG_PACKAGE_luci-app-ttyd=y
# 系统监控（collectd + rrdtool 图表）
CONFIG_PACKAGE_luci-app-statistics=y
# 透明代理：OpenClash
CONFIG_PACKAGE_luci-app-openclash=y
# DNS：SmartDNS（可与 OpenClash 配合做国内外分流）
CONFIG_PACKAGE_luci-app-smartdns=y
# 流控：SQM（cake 算法，抑制 bufferbloat）
CONFIG_PACKAGE_luci-app-sqm=y
# UPnP / NAT-PMP（nftables 版）
CONFIG_PACKAGE_luci-app-upnp=y
# 本机型无 USB 接口，不包含 diskman / hd-idle / samba4；
# 需要时可参考 rax3000m.config 中的应用列表。
